<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mycompany.pay.orders.controller.MateriaPrimaController"
      spacing="10">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10" />
    </padding>

    <Label text="Gestión de Materias Primas" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <TableView fx:id="tablaMateriaPrima" prefHeight="400">
        <columns>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="180" />
            <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="250" />
            <TableColumn fx:id="colUnidadMedida" text="Unidad Medida" prefWidth="120" />
            <TableColumn fx:id="colStockActual" text="Stock Actual" prefWidth="120" />
        <TableColumn fx:id="colStockMinimo" text="Stock Mínimo" prefWidth="120" />
        </columns>
    </TableView>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="btnAgregar" text="Agregar" />
        <Button fx:id="btnEditar" text="Editar" />
        <Button fx:id="btnEliminar" text="Eliminar" />
        <Button fx:id="btnRegistrarMovimiento" text="Registrar Movimiento" />
        <Button fx:id="btnVerHistorial" text="Ver Historial" />

    </HBox>

    <Label fx:id="lblMensaje" style="-fx-text-fill: red;" />

</VBox>
