<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mycompany.pay.orders.controller.ClientesFormController"
      spacing="10">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Gestión Clientes" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <HBox spacing="15">
        <VBox spacing="10" prefWidth="300">
            <Label text="Lista de Clientes:"/>
            <ListView fx:id="listaClientes" prefHeight="200"/>
        </VBox>

        <GridPane hgap="10" vgap="10" prefWidth="400">
            <Label text="Cédula:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txtCedula" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Nombre:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="txtNombre" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Apellido:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="txtApellido" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Teléfono:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="txtTelefono" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <HBox spacing="10" GridPane.rowIndex="4" GridPane.columnIndex="1" alignment="CENTER_RIGHT">
                <padding>
                    <Insets top="10" right="0" bottom="0" left="0"/>
                </padding>
                <Button fx:id="btnGuardar" text="Guardar"/>
                <Button fx:id="btnCancelar" text="Cancelar"/>
                <Button fx:id="btnNuevo" text="Nuevo"/>
                <Button fx:id="btnEliminar" text="Eliminar"/>
            </HBox>
        </GridPane>
    </HBox>

    <Label fx:id="lblMensaje" style="-fx-text-fill: red;" wrapText="true"/>
</VBox>
