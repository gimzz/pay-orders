<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mycompany.pay.orders.controller.UsuarioController"
      spacing="10">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <Label text="Gestión de Usuarios y Roles" style="-fx-font-size: 18px;"/>

    <TableView fx:id="tablaUsuarios" prefHeight="400" prefWidth="600">
        <columns>
            <TableColumn fx:id="colUsuario" text="Usuario" prefWidth="200"/>
            <TableColumn fx:id="colRol" text="Rol" prefWidth="200"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="150"/>
        </columns>
    </TableView>

    <HBox spacing="10">
        <Button text="Agregar Usuario" onAction="#abrirFormularioAgregar"/>
        <Button text="Editar Usuario" onAction="#abrirFormularioEditar"/>
        <Button text="Eliminar Usuario" onAction="#eliminarUsuario"/>
    </HBox>

    <Label fx:id="lblMensaje" style="-fx-text-fill: red;"/>
</VBox>
