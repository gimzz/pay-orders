<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mycompany.pay.orders.controller.ProductoViewController">
    <top>
        <Label text="Gestión de Productos"
               style="-fx-font-size: 18px; -fx-font-weight: bold;"
               BorderPane.alignment="CENTER"/>
    </top>
    <center>
        <TableView fx:id="tablaProductos" prefWidth="500" prefHeight="400">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="200"/>
                <TableColumn fx:id="colPrecioUsd" text="Precio USD" prefWidth="120"/>
            </columns>
        </TableView>
    </center>

    <right>
       <VBox fx:id="formularioContainer" spacing="10" prefWidth="300">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
</VBox>

    </right>

    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button fx:id="btnAgregar" text="Agregar" onAction="#mostrarFormularioNuevo"/>
            <Button fx:id="btnEditar" text="Editar" onAction="#mostrarFormularioEditar"/>
            <Button fx:id="btnEliminar" text="Eliminar" onAction="#eliminarProducto"/>
        </HBox>
    </bottom>
</BorderPane>
