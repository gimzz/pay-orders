<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mycompany.pay.orders.controller.ProductoFormController"
      spacing="10">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Formulario Producto" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10" prefWidth="400">

        <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNombre" prefWidth="250" GridPane.rowIndex="0" GridPane.columnIndex="1" promptText="Ingrese nombre"/>

        <Label text="Precio USD:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtPrecioUsd" prefWidth="250" GridPane.rowIndex="1" GridPane.columnIndex="1" promptText="Ingrese precio en USD"/>

    </GridPane>

    <Label fx:id="lblMensaje" style="-fx-text-fill: red;" wrapText="true"/>

    <HBox spacing="15" alignment="CENTER_RIGHT">
        <Button text="Guardar" onAction="#guardar" minWidth="80"/>
        <Button text="Cancelar" onAction="#cancelar" minWidth="80"/>
    </HBox>
</VBox>
