<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mycompany.pay.orders.controller.ClienteFormController"
      spacing="10">
    <padding>
        <Insets top="10" right="0" bottom="0" left="0"/>
    </padding>

    <Label text="Informacion Cliente:" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    
    <GridPane hgap="10" vgap="10">
        <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNombre" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="15" alignment="CENTER_RIGHT">
        <padding>
            <Insets top="10" right="0" bottom="0" left="0"/>
        </padding>
        <Button text="Guardar" onAction="#handleGuardar"/>
        <Button text="Cancelar" onAction="#handleCancelar"/>
    </HBox>

    <Label fx:id="lblMensaje" style="-fx-text-fill: red;" wrapText="true"/>
</VBox>
