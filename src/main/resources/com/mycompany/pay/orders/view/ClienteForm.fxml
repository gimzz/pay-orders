<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mycompany.pay.orders.controller.ClienteFormController"
      spacing="10">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Formulario de Cliente" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Cédula:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
        <TextField fx:id="txtCedula" GridPane.rowIndex="0" GridPane.columnIndex="1" />

        <Label text="Nombre (o Apodo):" GridPane.rowIndex="1" GridPane.columnIndex="0" />
        <TextField fx:id="txtNombre" GridPane.rowIndex="1" GridPane.columnIndex="1" />

        <Label text="Apellido:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
        <TextField fx:id="txtApellido" GridPane.rowIndex="2" GridPane.columnIndex="1" />

        <Label text="Teléfono:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
        <TextField fx:id="txtTelefono" GridPane.rowIndex="3" GridPane.columnIndex="1" />
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Guardar" onAction="#handleGuardar" />
        <Button text="Cancelar" onAction="#handleCancelar" />
    </HBox>

    <Label fx:id="lblMensaje" style="-fx-text-fill: red;" wrapText="true"/>
</VBox>
