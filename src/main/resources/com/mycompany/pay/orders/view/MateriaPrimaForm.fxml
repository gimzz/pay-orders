<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mycompany.pay.orders.controller.MateriaPrimaFormController"
      spacing="10">
<padding>
    <Insets top="15" right="15" bottom="15" left="15" />
</padding>
    <Label text="Formulario Materia Prima" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
    <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
    <TextField fx:id="txtNombre" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="250"/>

    <Label text="Descripción:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
    <TextArea fx:id="txtDescripcion" GridPane.rowIndex="1" GridPane.columnIndex="1" prefRowCount="3" prefWidth="250"/>

    <Label text="Unidad Medida:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
    <TextField fx:id="txtUnidadMedida" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="250"/>

    <Label text="Stock Actual:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
    <TextField fx:id="txtStockActual" GridPane.rowIndex="3" GridPane.columnIndex="1" prefWidth="250"/>

    <Label text="Stock Mínimo:" GridPane.rowIndex="4" GridPane.columnIndex="0" />
    <TextField fx:id="txtStockMinimo" GridPane.rowIndex="4" GridPane.columnIndex="1" prefWidth="250"/>
</GridPane>


    <Label fx:id="lblMensaje" style="-fx-text-fill: red;" wrapText="true"/>

    <HBox spacing="15" alignment="CENTER_RIGHT">
        <Button text="Guardar" onAction="#handleGuardar" minWidth="80"/>
        <Button text="Cancelar" onAction="#handleCancelar" minWidth="80"/>
    </HBox>
</VBox>
