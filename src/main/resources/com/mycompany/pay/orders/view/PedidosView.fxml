<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mycompany.pay.orders.controller.PedidosViewController"
      spacing="10">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
    <Label text="Gestión de Pedidos" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <TableView fx:id="tablaPedidos" prefHeight="400" prefWidth="900">
        <columns>
            <TableColumn fx:id="colClienteNombre" text="Cliente" prefWidth="150"/>
            <TableColumn fx:id="colTotalUsd" text="Total USD" prefWidth="100"/>
            <TableColumn fx:id="colTotalBsd" text="Total Bsd" prefWidth="100"/>
            <TableColumn fx:id="colTasaCambio" text="Tasa Cambio Aplicada" prefWidth="110"/>
            <TableColumn fx:id="colEstadoPago" text="Estado de Pago" prefWidth="120"/>
            <TableColumn fx:id="colMetodoPago" text="Método de Pago" prefWidth="120"/>
            <TableColumn fx:id="colEntregado" text="Entrega" prefWidth="100"/>
            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="130"/>
        </columns>
    </TableView>
    <HBox spacing="10">
        <Button text="Nuevo Pedido" onAction="#abrirFormularioNuevoPedido"/>
        <Button text="Editar Pedido" onAction="#abrirFormularioEditarPedido"/>
        <Button text="Eliminar Pedido" onAction="#eliminarPedido"/>
        <Button text="Actualizar Estado Entrega" onAction="#actualizarEstadoEntrega"/>
        <Button text="Ver Productos del Cliente" onAction="#mostrarProductosCliente"/>
    </HBox>
    <Label fx:id="lblMensaje" style="-fx-text-fill: red;" />
</VBox>