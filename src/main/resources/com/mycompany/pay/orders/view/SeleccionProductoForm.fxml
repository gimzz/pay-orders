<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mycompany.pay.orders.controller.SeleccionProductoFormController"
      spacing="10"
      prefWidth="600" prefHeight="400"
      minWidth="500" minHeight="350">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
    <Label text="Seleccionar Producto" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    
    <TableView fx:id="tablaProductos" prefHeight="300" prefWidth="580" editable="false">
        <columns>
            <TableColumn fx:id="colNombreProducto" text="Producto" prefWidth="380"/>
            <TableColumn fx:id="colPrecioProducto" text="Precio USD" prefWidth="200"/>
        </columns>
    </TableView>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Cantidad:"/>
        <Spinner fx:id="spinnerCantidad" prefWidth="100"/>
    </HBox>

    <HBox spacing="15" alignment="CENTER_RIGHT">
        <Button text="Agregar" onAction="#onAgregarProducto"/>
        <Button text="Cancelar" onAction="#onCancelar"/>
    </HBox>
</VBox>
